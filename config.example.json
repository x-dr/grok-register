{
  "method": "protocol",
  "_method_comment": "protocol=协议注册(默认); browser=cloakbrowser 浏览器注册。browser 默认 captcha.mode/local 本地过盾注入 token",
  "headless": false,
  "_headless_comment": "仅 browser 方式有效；false=有界面更稳",
  "email": "cfmail",
  "count": 1,
  "threads": 1,
  "no_oauth": true,
  "enable_nsfw": true,
  "proxy": "",
  "_proxy_hint": "可选: socks5h://127.0.0.1:40000 (WARP) 或 http://127.0.0.1:7890；SOCKS 需 pip install PySocks",
  "captcha": {
    "provider": "local",
    "yescaptcha_key": "",
    "yescaptcha_endpoint": "",
    "solver_url": "http://127.0.0.1:5072",
    "mode": "local",
    "_mode_comment": "browser 用: local|yescaptcha|click"
  },
  "cfmail": {
    "base_url": "https://xxxxx.xyz",
    "admin_password": "你的ADMIN_PASSWORDS",
    "site_password": "",
    "domain": ""
  },
  "tempmail": {
    "api_key": ""
  },
  "cloudflare": {
    "api_token": "",
    "account_id": "",
    "d1_db_id": "",
    "domains": ""
  },
  "22do": {
    "_comment": "无需 API Key；可选 proxy 走全局 proxy 字段",
    "prefer_hotmail": true
  },
  "oauth": {
    "cliproxyapi_auth_dir": "./cliproxyapi_auth",
    "cliproxyapi_base_url": "https://cli-chat-proxy.grok.com/v1",
    "accounts_output_dir": "./accounts_output"
  },
  "accounts_output_dir": "./accounts_output",
  "no_save": false,
  "json": false,
  "_comment": "method: protocol|browser；protocol 与 browser 默认均可 provider=local + ./scripts/start-solver.sh；browser 可用 captcha.mode=click 页内点击（不推荐）",
  "export": {
    "enabled": true,
    "dir": "./exports",
    "formats": [
      "auth",
      "sub2api",
      "cliproxyapi",
      "bundle",
      "sso"
    ]
  },
  "sub2api": {
    "enabled": false,
    "base_url": "http://127.0.0.1:8080",
    "email": "admin@example.com",
    "password": "your-password",
    "group_id": null,
    "group_name": "grok-register_22do",
    "auto_create_group": true,
    "auto_push_on_register": false,
    "concurrency": 4,
    "account_concurrency": 3,
    "account_priority": 50,
    "notes_prefix": "grok-register"
  },
  "cliproxyapi": {
    "enabled": false,
    "base_url": "http://127.0.0.1:8317",
    "management_key": "your-management-key",
    "auto_push_on_register": false,
    "concurrency": 4,
    "base_upstream": "https://cli-chat-proxy.grok.com/v1",
    "notes_prefix": "grok-register"
  }
}
